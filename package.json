{
  "name": "campus-stats",
  "version": "0.4.4",
  "description": "Campus — installable women's football data layer for apps (clubs, national teams, matches, fantasy points)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "campus": "./dist/cli.js",
    "campus-stats": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "campus",
    "campus-stats",
    "football",
    "soccer",
    "women",
    "fantasy",
    "stats",
    "statsbomb",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Minacava/campus-stats.git"
  },
  "homepage": "https://campus-tawny-mu.vercel.app/",
  "bugs": {
    "url": "https://github.com/Minacava/campus-stats/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
