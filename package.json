{
  "name": "campo-stats",
  "version": "0.2.0",
  "description": "Installable women's football data layer for apps — clubs, national teams, matches, lineups, fantasy points",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "campo-stats": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "football",
    "soccer",
    "women",
    "fantasy",
    "stats",
    "statsbomb",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/marina34/campus.git"
  },
  "homepage": "https://gitlab.com/marina34/campus",
  "bugs": {
    "url": "https://gitlab.com/marina34/campus/-/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
